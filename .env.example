# Copy to .env (git-ignored). Never commit real values.

# qBittorrent WebUI login (leave both empty if the WebUI skips auth for this network)
QBIT_USER=
QBIT_PASS=

# Source trackers: part of the announce host name, comma separated.
# Every completed torrent seeding from one of these is searched on the targets.
SOURCE_TRACKERS=tracker-a.example

# Target indexers: name|torznab_url, comma separated (e.g. Prowlarr: http://prowlarr:9696/<id>/api).
TARGETS=tracker-b|http://prowlarr:9696/2/api,tracker-c|http://prowlarr:9696/3/api

# API key added to every Torznab request (e.g. your Prowlarr API key). Leave empty if it is in the URLs.
TORZNAB_APIKEY=
